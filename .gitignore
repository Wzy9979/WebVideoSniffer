# ============================================================
#  绝对不能提交的东西
# ============================================================

# 浏览器嗅探用的独立配置目录。
# 里面有 Network/Cookies、Login Data（保存的密码）、History（浏览历史）、
# 各类 Local Storage —— 属于个人凭据，一旦公开等于把账号交出去。
browser_profile/

# 下载成品目录。里面是个人下载的内容，体积也很大。
downloads/

# 手动导出的 Cookie 文件（Netscape 格式）。
# 它等同于登录凭证，用来给 yt-dlp 过登录/人机校验的。
cookies.txt
*.cookies.txt
*_cookies.txt

# ============================================================
#  常规忽略
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# 下载 / 转码中间产物
*.part
*.tmp
.tmp/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 日志
*.log

# PyInstaller 打包产物（只保留源码和 run.bat）
build/
dist/
*.spec
